<Window x:Class="AdenRising.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aden Rising" Height="740" Width="1080"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

  <!-- The frame and its shadow are why the window stops looking like a picture
       of a program: it now has an edge and sits above the desktop. Drawn inside
       a transparent window, which is the only way WPF will paint outside the
       client area. -->
  <Border Margin="20" BorderThickness="1" Background="{StaticResource PaperFall}">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C8A263" Offset="0"/>
        <GradientStop Color="#B88A45" Offset="0.45"/>
        <GradientStop Color="#7E5C2A" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
    </Border.Effect>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="150"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="118"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="{StaticResource Charcoal}" MouseLeftButtonDown="Titlebar_Drag">
      <Rectangle Fill="{StaticResource DarkGlow}" IsHitTestVisible="False"/>
      <Image Source="pack://application:,,,/Assets/wordmark.png" Height="24" HorizontalAlignment="Left"
                 VerticalAlignment="Center" Margin="28,0,0,0"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- A window inside a screen: put this one back in the middle of the
             main one. Drawn on a Canvas so the shapes keep their own
             coordinates instead of being centred by their bounding box. -->
        <Button Style="{StaticResource WinBtn}" Click="Centre_Click"
                ToolTip="Centre on the main screen">
          <Canvas Width="20" Height="20">
            <Path Data="M1.5,4.5 H18.5 V15.5 H1.5 Z" StrokeThickness="1.2" Fill="Transparent"
                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
            <Path Data="M7.5,8.5 H12.5 V11.5 H7.5 Z"
                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
          </Canvas>
        </Button>
        <Button Style="{StaticResource WinBtn}" Click="Minimise_Click">
          <Path Data="M5,10 H15" StrokeThickness="1.4" Width="20" Height="20" Stretch="None"
                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
        </Button>
        <Button Style="{StaticResource CloseBtn}" Click="Close_Click">
          <Path Data="M6,6 L14,14 M14,6 L6,14" StrokeThickness="1.4" Width="20" Height="20" Stretch="None"
                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- The hero band, with the site's vignette: darkened at the edges so the
         art sits in the page rather than being pasted on top of it. -->
    <Grid Grid.Row="1" ClipToBounds="True">
      <Image Source="Assets/hero.jpg" Stretch="UniformToFill" VerticalAlignment="Bottom"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush GradientOrigin="0.35,0.4" Center="0.35,0.4" RadiusX="0.85" RadiusY="1.1">
            <GradientStop Color="#00171714" Offset="0.35"/>
            <GradientStop Color="#2B171714" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00EEE8DC" Offset="0.42"/>
            <GradientStop Color="#A8EEE8DC" Offset="0.82"/>
            <GradientStop Color="#FFEEE8DC" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="316"/>
      </Grid.ColumnDefinitions>

      <!-- The site fills its own empty space with oversized, very faint marks
           (section numerals, the monogram). Without something here the panel
           reads as a blank sheet. -->
      <Path Grid.Column="0" Data="" Fill="#0D171714" Stretch="Uniform"
            Width="250" HorizontalAlignment="Right" VerticalAlignment="Center"
            Margin="0,0,-34,0" IsHitTestVisible="False">
        <Path.RenderTransform><ScaleTransform ScaleY="-1" CenterY="0.5"/></Path.RenderTransform>
      </Path>

      <StackPanel x:Name="Stage" Grid.Column="0" Margin="44,0,44,0" VerticalAlignment="Center">

        <!-- Eyebrow: two runs of tracked capitals with a hairline set between
             them, exactly as on the site. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="EyebrowLead" Style="{StaticResource EyebrowText}"/>
          <Rectangle x:Name="EyebrowRule" Width="45" Height="1" Margin="18,0" Opacity="0.8"
                     VerticalAlignment="Center"
                     Fill="{Binding ElementName=EyebrowLead, Path=Foreground}"/>
          <TextBlock x:Name="EyebrowTail" Style="{StaticResource EyebrowText}"/>
        </StackPanel>

        <Grid Margin="0,18,0,0" Width="600" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Headline" Grid.Column="0" Style="{StaticResource H1}" TextWrapping="Wrap"/>
          <TextBlock x:Name="Percent" Grid.Column="1" Style="{StaticResource H1}" Margin="20,0,0,0"
                     VerticalAlignment="Bottom" Foreground="{StaticResource Gold}"/>
        </Grid>

        <TextBlock x:Name="Body" Margin="0,16,0,0" MaxWidth="480" HorizontalAlignment="Left"
                   Style="{StaticResource Lead}"/>

        <StackPanel x:Name="FolderPanel" Visibility="Collapsed" Margin="0,22,0,0"
                    HorizontalAlignment="Left" Width="600">
          <Border BorderBrush="#3D171714" BorderThickness="1" Background="{StaticResource Paper}" MinHeight="54">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FolderText" Grid.Column="0" Margin="18,0"
                         VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"
                         TextTrimming="CharacterEllipsis" Foreground="{StaticResource Charcoal}"/>
              <Button x:Name="BrowseButton" Grid.Column="1" Click="Browse_Click" Content="BROWSE"
                      Style="{StaticResource BtnQuiet}" MinHeight="54"
                      BorderBrush="#3D171714" BorderThickness="1,0,0,0"/>
            </Grid>
          </Border>
          <TextBlock x:Name="SpaceText" Style="{StaticResource Caption}" Margin="0,11,0,0"/>
        </StackPanel>

        <Grid x:Name="TrackRow" Margin="0,24,0,0" Width="600" HorizontalAlignment="Left"
              Height="6" Visibility="Collapsed">
          <Rectangle Fill="#1F171714"/>
          <Rectangle x:Name="Fill" Fill="{StaticResource Gold}" HorizontalAlignment="Left" Width="0"/>
        </Grid>

        <Grid x:Name="StatsRow" Margin="0,13,0,0" Width="600" HorizontalAlignment="Left"
              Visibility="Collapsed">
          <TextBlock x:Name="LeftStat" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="RightStat" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
          <Button x:Name="PlayButton" Style="{StaticResource BtnPrimary}" MinWidth="250" MinHeight="76"
                  FontSize="16" Content="PLAY" Click="Play_Click" Visibility="Collapsed"/>
          <Button x:Name="VerifyButton" Style="{StaticResource BtnOutline}" MinWidth="216" MinHeight="76"
                  Margin="16,0,0,0" Content="VERIFY FILES" Click="Verify_Click" Visibility="Collapsed"/>
          <Button x:Name="InstallButton" Style="{StaticResource BtnPrimary}" MinWidth="230"
                  Content="INSTALL" Click="Install_Click" Visibility="Collapsed"/>
          <Button x:Name="PauseButton" Style="{StaticResource BtnOutline}" MinWidth="186"
                  Content="PAUSE" Click="Pause_Click" Visibility="Collapsed"/>
          <Button x:Name="CancelButton" Style="{StaticResource BtnQuiet}" MinHeight="66"
                  Margin="18,0,0,0" Content="CANCEL" Click="Cancel_Click" Visibility="Collapsed"/>
          <Button x:Name="CloseGameButton" Style="{StaticResource BtnPrimary}" MinWidth="270"
                  Content="CLOSE THE GAME" Click="CloseGame_Click" Visibility="Collapsed"/>
          <Button x:Name="RetryButton" Style="{StaticResource BtnPrimary}" MinWidth="230"
                  Content="TRY AGAIN" Click="Retry_Click" Visibility="Collapsed"/>
          <CheckBox x:Name="ShortcutCheck" Style="{StaticResource SquareCheck}" IsChecked="True"
                    Visibility="Collapsed" VerticalAlignment="Center" Margin="30,0,0,0"
                    Content="Put a shortcut on the desktop"/>
        </StackPanel>
      </StackPanel>

      <Rectangle Grid.ColumnSpan="2" Height="14" VerticalAlignment="Bottom" IsHitTestVisible="False"
                 Panel.ZIndex="2">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#1A171714" Offset="0"/>
            <GradientStop Color="#00171714" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,22,24,14">
            <TextBlock x:Name="NewsHeading" Style="{StaticResource EyebrowText}" FontSize="10"
                       Foreground="{StaticResource Muted}"/>
          </StackPanel>

          <Button DockPanel.Dock="Bottom" Style="{StaticResource NewsItem}" Click="AllNews_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="AllNewsLabel" Grid.Column="0" Style="{StaticResource EyebrowText}"
                         FontSize="10" Foreground="{StaticResource GoldDark}" VerticalAlignment="Center"/>
              <Path Grid.Column="1" Data="M4,10 H15 M11,5 L16,10 L11,15" Width="20" Height="20"
                    Stretch="None" Stroke="{StaticResource GoldDark}" StrokeThickness="1.5"
                    VerticalAlignment="Center"/>
            </Grid>
          </Button>

          <!-- Shown until the feed answers, and left showing if it never does.
               Better an honest blank than three invented headlines. -->
          <TextBlock x:Name="NewsEmpty" DockPanel.Dock="Top" Margin="26,26,26,0"
                     TextWrapping="Wrap" FontSize="13" LineHeight="21"
                     Foreground="{StaticResource Muted}"
                     Text="Nothing new to report right now."/>
          <ItemsControl x:Name="NewsList" DockPanel.Dock="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource NewsItem}" Tag="{Binding Url}" Click="News_Click">
                  <StackPanel>
                    <TextBlock Text="{Binding Date}" Style="{StaticResource EyebrowText}"
                               FontSize="10" Foreground="{StaticResource GoldDark}"/>
                    <TextBlock Text="{Binding Title}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Style="{StaticResource DisplayText}" FontSize="17"
                               Foreground="{StaticResource Charcoal}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- The rate-bar from the website: a gold diamond straddling the top edge,
         a widely tracked label over a big display value. The three cells change
         with the state rather than being a fixed set of numbers. -->
    <Grid Grid.Row="3" Background="{StaticResource Charcoal}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- A lit top edge, so the strip looks like a piece set into the window
           rather than a rectangle painted on it. -->
      <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="#26FFFFFF"
                 IsHitTestVisible="False" Panel.ZIndex="3"/>
      <Rectangle Grid.ColumnSpan="3" Fill="{StaticResource DarkGlow}" IsHitTestVisible="False"/>

      <Border Grid.Column="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
        <StackPanel VerticalAlignment="Center" Margin="34,0">
          <TextBlock x:Name="Stat1Label" Style="{StaticResource StatLabelText}"/>
          <TextBlock x:Name="Stat1Value" Style="{StaticResource StatValueText}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
        <StackPanel VerticalAlignment="Center" Margin="34,0">
          <TextBlock x:Name="Stat2Label" Style="{StaticResource StatLabelText}"/>
          <TextBlock x:Name="Stat2Value" Style="{StaticResource StatValueText}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2">
        <StackPanel VerticalAlignment="Center" Margin="34,0">
          <TextBlock x:Name="Stat3Label" Style="{StaticResource StatLabelText}"/>
          <TextBlock x:Name="Stat3Value" Style="{StaticResource StatValueText}"/>
        </StackPanel>
      </Border>

      <!-- The site's rate-bar marker: a gold diamond straddling the top edge with
           a 6px charcoal ring around it (box-shadow: 0 0 0 6px). Without the ring
           it reads as a stray gold dot rather than a notch cut into the bar. -->
      <Grid Grid.ColumnSpan="3" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,-17,0,0" IsHitTestVisible="False">
        <Rectangle Width="21" Height="21" Fill="{StaticResource Charcoal}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
          <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="9" Height="9" Fill="{StaticResource Gold}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
          <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
        </Rectangle>
      </Grid>
    </Grid>
  </Grid>
  </Border>
</Window>
